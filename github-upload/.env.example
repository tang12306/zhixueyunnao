# 复制为 .env 后填写。docker compose 和 Spring Boot 都会读取这个文件（值不要加引号）。
# .env 已在 .gitignore 中，不会被提交。

# MySQL（docker compose 用它作为 root 密码，后端用它连接数据库）
DB_USERNAME=root
DB_PASSWORD=

# DeepSeek API 密钥，使用 AI 出题时需要
DEEPSEEK_API_KEY=

# 首个管理员账号：数据库里还没有管理员时，启动时用它创建（密码至少 8 位）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# dev：创建公开密码的演示账号、打印 SQL。生产环境留空或删除这一行
SPRING_PROFILES_ACTIVE=dev

# 上线 HTTPS 后改为 true，会话 Cookie 只经 HTTPS 发送
# COOKIE_SECURE=true
